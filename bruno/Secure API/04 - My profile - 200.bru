meta {
  name: My profile - 200
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

tests {
  test("My profile - 200", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.user.role).to.equal("USER");
  });
  test("Response includes a request ID", function () {
    expect(res.getBody().requestId).to.be.a("string");
  });
}
