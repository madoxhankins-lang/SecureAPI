# Run npm run setup to generate a random local secret and admin password.
PORT=3000
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_TTL_SECONDS=900
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-local-password
CORS_ORIGINS=http://localhost:5173
LOG_DIR=logs
# Local demo allowance; the server defaults to 10 failed auth requests when unset.
AUTH_RATE_LIMIT=100
